# Google Cloud API-Key mit aktivierter "Places API (New)"
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_PLACES_API_KEY=

# Anthropic-API-Key fuer den Website-Generator (Reiter "Website-Generator" im
# Dashboard). Eigener Key, getrennt vom Google-Key: https://console.anthropic.com
# -> Settings -> API Keys. Kostet pro Generierung echtes Geld (ein vollstaendiger
# Seiten-Entwurf mit claude-opus-5-5 kostet typischerweise niedrige Cent-Betraege
# bis knapp ueber 1 Euro, abhaengig von Seitenlaenge) - Preise vorher pruefen:
# https://platform.claude.com/docs/en/about-claude/pricing
ANTHROPIC_API_KEY=

# Optional: anderes Modell fuer den Website-Generator (z.B. "claude-sonnet-5-5"
# fuer spuerbar geringere Kosten bei etwas einfacherem Ergebnis). Standard:
# claude-opus-5-5 (hoechste Qualitaet).
SITE_GEN_MODEL=

# Port, auf dem die App laeuft
PORT=3000

# Zugangsdaten fuer das interne Dashboard unter /app (Leads + Kontaktanfragen).
# WICHTIG: Ohne diese beiden Variablen ist /app fuer JEDEN im Internet offen!
# Vor dem Live-Gang unbedingt setzen (frei waehlbar, z.B. ein eigenes Passwort).
DASHBOARD_USER=
DASHBOARD_PASS=

# Nur noetig, falls die Landingpage mal getrennt vom Dashboard (andere Domain)
# gehostet wird und /api/contact von dort aufruft (CORS). Bei einem
# gemeinsamen Server/einer gemeinsamen Domain (Standard-Setup) ignorieren.
CONTACT_ALLOWED_ORIGIN=*

# Optional: SMTP-Zugangsdaten, damit bei einer neuen Kontaktanfrage zusaetzlich
# eine Benachrichtigungs-Mail verschickt wird. Ohne diese Variablen wird die
# Anfrage trotzdem gespeichert (sichtbar im Dashboard), nur die Mail entfaellt.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_NOTIFY_EMAIL=Phil.kuriat@tnc-group.de
